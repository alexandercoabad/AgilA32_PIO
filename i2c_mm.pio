; I2C multi-master master -- the SDK i2c program's structure, plus bit-level ARBITRATION.
;
; Polarity as pio/i2c.pio: PINDIR 1 = pull the line low, 0 = release (pull-up => high).
; Pins: SDA = OUT/SET/IN/JMP pin, SCL = SDA+1 = side-set pin.  Autopull 24 (shift left),
; autopush 8 (shift left, enable it only while reading).
;
; What arbitration needs: after releasing SDA for a '1', if the bus reads 0 somebody else is
; driving it and we have LOST -- we must let go of SDA *and* SCL immediately, or we corrupt the
; winner's byte.  Driving a '0' can never lose (wired-AND), and while READING we release SDA
; for every bit so the slave's zeros are normal.  So each bit carries TWO copies in the FIFO
; word: [drive] goes to `out pindirs`, [tolerate-low] goes to X.  For a write bit both are the
; same; for a read bit tolerate-low is forced to 1.  No per-byte mode register is needed.
;
; TX word (32 bit, MSB first):  [31:26] n        instr count (n > 0: next n+1 words are EXECuted,
;                                                each as instr<<16)
;                               [25:10] 8 x {drive, tolerate-low}, data bit 7 first
;                               [9:8]   {drive, NAK-ok} for the ACK slot
;   n = 0 -> data record.  A NAK with NAK-ok = 0 raises IRQ 0 (rel); losing arbitration raises
;   IRQ 1 (rel).  Both wait for the host, which must FIFO-clear + SM_RESTART + jump to entry_point.
; One SCL period = 32 PIO ticks (33 at CLKDIV 1, see docs: 2-flop synchroniser on `wait`).
;
; LIMITATION -- NO BUS-BUSY DETECTION: nothing here checks that the bus is free before a START, and the
; program does not follow START / STOP. Arbitration protects the bits AFTER a START, not the START itself:
; a START issued while another master is mid-transaction can look like a second START to the slave and
; destroy that transaction (measured: 2 of 8 timings), and the "lost" flag (IRQ 1) does not mean the
; other master is unharmed. The HOST must first read PINS_IN until SDA and SCL have both been high for a
; bus-free time, before the first START and again before retrying after a loss. See docs/info.md.

.program i2c_mm
.side_set 1 opt pindirs

.define public SCL_LOW  1
.define public SCL_HIGH 0

do_nack:
    jmp x-- entry_point                    ; NAK acceptable (x = 1)? continue
    irq wait 0 rel                         ; otherwise flag a NAK error and wait for the host
    jmp entry_point
lost:
    set pindirs, 0 side SCL_HIGH           ; arbitration lost: release SDA and SCL at once
    irq wait 1 rel                         ; tell the host, wait for it
    jmp entry_point
do_byte:
    set y, 7
bitloop:
    out pindirs, 1                     [7] ; drive SDA (1 = pull low)
    out x, 1                               ; x = tolerate-low
    nop             side SCL_HIGH      [2] ; SCL rising edge
    wait 1 pin, 1                      [4] ; clock synchronisation / stretching
    jmp pin sdahi                          ; SDA high: fine
    jmp x-- sdahi                          ; SDA low and a low is expected: fine
    jmp lost                               ; SDA low but we released it: someone else won
sdahi:
    in pins, 1                         [7] ; sample (read data)
    jmp y-- bitloop side SCL_LOW       [7] ; SCL falling edge
    out pindirs, 1                     [7] ; ACK slot: master ACK on reads, released on writes
    out x, 1                               ; x = NAK-ok
    nop             side SCL_HIGH      [7]
    wait 1 pin, 1                      [7]
    jmp pin do_nack side SCL_LOW       [2] ; SDA high = NAK

public entry_point:
.wrap_target
    out x, 6                               ; instruction count
    jmp !x do_byte                         ; 0 -> data record
    out null, 32                           ; discard the rest of this word
do_exec:
    out exec, 16                           ; run one instruction per FIFO word
    out null, 8
    jmp x-- do_exec
.wrap
