# Constrained-random protocol tests for the PIO block on its own (see test_pio_random.py):
#     cd test && make -f Makefile.random [PIO_RANDOM_SEED=<n>] [PIO_RANDOM_N=<iterations>]
SIM ?= icarus
TOPLEVEL_LANG ?= verilog
SRC_DIR = $(PWD)/../src
VERILOG_SOURCES = $(SRC_DIR)/pio.v $(SRC_DIR)/pio_sm.v $(SRC_DIR)/pio_fifo.v
COMPILE_ARGS += -I$(SRC_DIR)
TOPLEVEL = pio
COCOTB_TEST_MODULES = test_pio_random
SIM_BUILD = sim_build/random
PIO_RANDOM_SEED ?= 1
PIO_RANDOM_N ?= 12
export PIO_RANDOM_SEED
export PIO_RANDOM_N
include $(shell cocotb-config --makefiles)/Makefile.sim
