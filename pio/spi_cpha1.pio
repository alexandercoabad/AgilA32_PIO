; SPI master, mode 1 (CPOL=0, CPHA=1) -- Pico SDK `spi_cpha1`, unmodified.
; OUT/MOV pin = MOSI, side-set pin = SCK, IN pin = MISO.
; Data changes on the rising SCK edge and is sampled on the falling edge.
; Autopull/autopush 8 bits, shift left (MSB first). SCK = clk / (4 * CLKDIV).
.program spi_cpha1
.side_set 1

    out x, 1    side 0     ; Stall here on empty (keep SCK deasserted)
    mov pins, x side 1 [1] ; Output data, assert SCK (mov pins uses OUT pins group)
    in pins, 1  side 0     ; Input data, deassert SCK
